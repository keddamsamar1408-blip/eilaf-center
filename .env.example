# Secret used to sign admin session JWTs. Change this to a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-string-in-production

# Default admin account, created only the very first time the app runs
# (when the admins table is first seeded). Change the password from the
# dashboard after first login instead of relying on this afterwards.
ADMIN_EMAIL=admin@eilaf-center.com
ADMIN_PASSWORD=Eilaf@2026Admin
